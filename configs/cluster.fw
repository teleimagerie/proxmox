[OPTIONS]

enable: 1
policy_in: DROP
policy_out: ACCEPT

[IPSET cluster] # Les 3 hyperviseurs : IP publiques + tous les reseaux vRack

91.134.84.222
51.68.240.48
51.68.240.191
10.100.0.0/24
10.200.0.0/24
10.30.0.0/24

[IPSET admin] # Portes d administration - SOURCE REELLEMENT VUE PAR LE NOEUD
# 10.90.0.0/24 = VPN nomade wg0, vu tel quel car le trafic sort par la patte
# LAN d OPNsense (pas de NAT) vers les pattes 10.40.0.2/.3/.4 : verifie le
# 31/08/2026. Viser une IP PUBLIQUE depuis le VPN serait NATe en .121 et ne
# matcherait pas -> l administration passe par les noms pveN.infra (overrides
# Unbound) ou par 10.40.0.x, jamais par les IP publiques.
# La porte tailnet n a pas a figurer ici : en mode userspace elle livre
# depuis 127.0.0.1 et echappe a ce pare-feu (filtrage par l ACL headscale).

10.90.0.0/24

[RULES]

# --- Trafic inter-noeuds : Corosync, Ceph, migration, pmxcfs ---
IN ACCEPT -source +cluster -log nolog

# --- Supervision : Zabbix (CT 204) interroge l API PVE par le chemin PRIVE
# --- depuis le 31/08/2026 (overrides Unbound : pveN.infra -> 10.40.0.x).
# --- CETTE LIGNE DOIT RESTER AVANT LE DROP CI-DESSOUS, sinon elle est avalee
# --- et toute la supervision du cluster s eteint en silence (17-zabbix.md).
IN ACCEPT -source 10.40.0.60 -p tcp -dport 8006 -log nolog

# --- Les pattes VLAN 400 des 3 noeuds (10.40.0.2/.3/.4) sont sortantes
# --- uniquement : rien d autre du LAN VM ne doit joindre un hyperviseur
# --- (perennisee le 27/08/2026, etendue aux 3 noeuds le 31/08/2026)
IN DROP -source 10.40.0.0/24 -log nolog

# --- Acces administrateur : VPN UNIQUEMENT depuis le 01/09/2026 (V2+V3).
# --- Ferme a Internet : l API et SSH ne sont plus joignables que par le VPN
# --- nomade (10.90.0.0/24 -> pattes 10.40.0.2/.3/.4, ipset admin) ou par le
# --- tailnet (invisible ici : mode userspace, livraison depuis 127.0.0.1).
# --- Le 2FA reste en place, il ne remplace pas cette fermeture : il protege
# --- l authentification, pas la surface applicative de pveproxy.
# --- L inter-noeuds (corosync ring1 sur IP publiques, Ceph, migration) passe
# --- par la regle +cluster ci-dessus et n est PAS affecte.
IN ACCEPT -source +admin -p tcp -dport 8006 -log nolog  # interface web Proxmox
IN ACCEPT -source +admin -p tcp -dport 22 -log nolog    # SSH (par cle uniquement)
IN ACCEPT -source +admin -p tcp -dport 3128 -log nolog  # proxy SPICE - VPN seul (V1, 31/08/2026)
# 5900-5999 (VNC/SPICE direct) SUPPRIME le 31/08/2026 : rien n y ecoutait au
# repos, les consoles de l interface web passent par le WebSocket du 8006.
# Si une console directe cassait un jour, remettre la ligne restreinte a +admin.

# --- Seconde porte d administration : tailnet headscale (tag:pve).
# --- Les 3 noeuds tournent tailscale en --tun=userspace-networking : aucune
# --- route posee, la passerelle OVH 100.64.0.1 reste intacte. Ce port doit
# --- rester ouvert SANS restriction de source pour que le poste rejoigne le
# --- noeud EN DIRECT sur son IP publique, y compris quand OPNsense (donc le
# --- DERP et le plan de controle) est mort. WireGuard ne repond rien a un
# --- paquet non authentifie : la surface est sans commune mesure avec 22/8006.
# --- ATTENTION : ce trafic est livre depuis 127.0.0.1, donc invisible de ce
# --- pare-feu comme de fail2ban -> le filtrage repose sur l ACL headscale.
IN ACCEPT -p udp -dport 41641 -log nolog

# --- Diagnostic reseau ---
IN Ping(ACCEPT) -log nolog
